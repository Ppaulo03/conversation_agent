# Copy to .env (git-ignored) and fill in. Keys are read from the environment only.
# Run with: uv run --env-file .env python -m vertical_slice

# --- LLM (provider-agnostic) ---
# LLM_PROVIDER: groq | openai | openai_compat | anthropic
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile      # required for openai / openai_compat
# LLM_BASE_URL=http://localhost:11434/v1  # only for openai_compat (vLLM, Ollama, ...)
# Legacy fallbacks (used when LLM_API_KEY is empty): GROQ_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY

# --- Postgres (docker compose) ---
POSTGRES_USER=conversation_agent
POSTGRES_PASSWORD=conversation_agent_dev
POSTGRES_DB=conversation_agent
POSTGRES_PORT=5432